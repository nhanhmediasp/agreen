# ============================================================
# Sao chép file này thành .env rồi điền giá trị thật:
#     cp .env.example .env
#
# ⚠ .env đã nằm trong .gitignore — TUYỆT ĐỐI không commit.
# ⚠ Chỉ backend đọc các biến này. Vite chỉ expose biến có tiền tố VITE_
#   và NHÚNG THẲNG vào bundle công khai — đừng bao giờ đặt mật khẩu DB hay
#   JWT secret dưới dạng VITE_*.
# ============================================================

# ---------- Server ----------
PORT=5000
NODE_ENV=production
# Đặt múi giờ để ngày/giờ hợp đồng khớp với giờ Việt Nam
TZ=Asia/Ho_Chi_Minh

# ---------- PostgreSQL ----------
# Tạo database + user trong aaPanel > Databases > PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=car_rental_user
DB_PASSWORD=DatMatKhauManhVaoDay
DB_NAME=car_rental

# Thay cho 5 biến trên nếu muốn dùng connection string (ưu tiên hơn nếu có)
# DATABASE_URL=postgresql://car_rental_user:matkhau@127.0.0.1:5432/car_rental

# ---------- Bảo mật ----------
# BẮT BUỘC ở production. Server sẽ TỪ CHỐI khởi động nếu để trống hoặc để nguyên
# giá trị mẫu. Sinh secret ngẫu nhiên bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Thời hạn phiên đăng nhập
JWT_EXPIRES_IN=8h
SESSION_MAX_AGE_MS=28800000

# Chống brute-force: sai bao nhiêu lần thì khoá, và khoá bao lâu (giây)
MAX_FAILED_LOGINS=5
LOCKOUT_SECONDS=300

# ---------- CORS ----------
# ĐỂ TRỐNG nếu web và API cùng domain qua nginx (khuyến nghị — an toàn nhất).
# Chỉ điền khi frontend nằm ở domain khác, phân tách bằng dấu phẩy:
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=

# ---------- Upload ----------
# Thư mục lưu ảnh xe & PDF hợp đồng. Mặc định: server/uploads
# UPLOAD_DIR=/www/wwwroot/car-rental-dashboard/server/uploads
MAX_UPLOAD_MB=8

# ---------- Tài khoản quản trị (chỉ dùng khi chạy npm run db:seed) ----------
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Quản trị viên
# Để trống -> script tự sinh mật khẩu mạnh và in ra terminal MỘT LẦN.
ADMIN_PASSWORD=
