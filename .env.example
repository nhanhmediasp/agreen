# Server
PORT=5000
NODE_ENV=development
TRUST_PROXY_HOPS=0

# PostgreSQL (placeholders only)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
DB_NAME=replace_with_database_name
# Optional, test-only database used by the real migration integration test.
# TEST_DATABASE_URL=postgresql://test_user:replace_with_test_password@127.0.0.1:5432/agreen_test

# Authentication
# Use a unique random value with at least 32 characters. Rotate any secret that
# has ever been committed or shared. Never store the real value in this file.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
AUTH_TOKEN_TTL_SECONDS=28800

# Initial admin bootstrap (used only when the users table is empty).
# Remove BOOTSTRAP_ADMIN_PASSWORD from the runtime environment after bootstrap.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_FULL_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_one_time_password

# Comma-separated browser origins allowed to send credentialed API requests.
# Same-origin requests do not need an entry. Never use "*" with cookie auth.
CORS_ORIGIN=http://localhost:5173
