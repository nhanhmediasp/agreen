# Server Configuration
PORT=5000
NODE_ENV=production

# PostgreSQL Database Configuration (VPanel)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=vpanel_car_user
DB_PASSWORD=YourStrongPasswordHere
DB_NAME=vpanel_car_rental

# Connection String Alternative
DATABASE_URL=postgresql://vpanel_car_user:YourStrongPasswordHere@127.0.0.1:5432/vpanel_car_rental?sslmode=disable

# Security & CORS
JWT_SECRET=super_secret_jwt_key_change_me_in_production
CORS_ORIGIN=https://yourdomain.com
